# Copy to .env and adjust if needed. Never commit the real .env file.
# This demo has no authentication -- see README "Security" for why, and do
# not deploy it publicly with these defaults.

NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# --- Shared infrastructure ---
DATABASE_URL=postgres://jobrelay:jobrelay@localhost:5432/jobrelay
REDIS_URL=redis://localhost:6379
MAIN_QUEUE_NAME=jobrelay-jobs
DEMO_QUEUE_NAME=jobrelay-demo-jobs

# --- Upload / image limits ---
MAX_UPLOAD_BYTES=8000000
MAX_IMAGE_DIMENSION_PX=6000
MAX_IMAGE_PIXELS=30000000

# --- Retry / worker tuning ---
MAX_JOB_ATTEMPTS=5
BACKOFF_BASE_MS=500
BACKOFF_MAX_MS=30000
BACKOFF_JITTER=0.3
WORKER_CONCURRENCY=4
LOCK_DURATION_MS=8000
STALLED_INTERVAL_MS=2000
MAX_STALLED_COUNT=2

# --- Outbox dispatcher (runs inside the API process) ---
OUTBOX_SWEEP_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50

# --- Worker heartbeat (worker-station display) ---
WORKER_HEARTBEAT_INTERVAL_MS=1000
WORKER_OFFLINE_THRESHOLD_MS=3500

# --- File storage + retention ---
STORAGE_DIR=./data
RETENTION_MINUTES=60
RETENTION_SWEEP_INTERVAL_MS=60000

# --- Interactive demonstration panel ---
DEMO_ENABLED=true
DEMO_WORKER_COUNT=2
